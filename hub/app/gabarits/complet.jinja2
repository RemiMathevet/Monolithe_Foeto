{{ t | upper }}
{{ '=' * (t | length) }}
{%- endmacro -%}
{%- macro sous(t) -%}
{{ t }}
{{ '-' * (t | length) }}
{%- endmacro -%}
{%- macro champs(etape) -%}
{% for c in etape.champs %}
  {{ c.label }} : {{ c | valeur }}
{% endfor %}
{%- endmacro -%}
