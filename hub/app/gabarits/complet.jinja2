{# titre: Compte rendu complet #}
{# version: 2.0.0 #}
{# format: html #}
{#
   Ce gabarit parcourt les trames plutôt que de nommer les champs : un champ
   ajouté à un module apparaît ici sans qu'on y touche, avec son libellé. Ce
   qui n'a pas été rempli ne s'écrit pas — un compte rendu qui aligne des
   « non renseigné » se relit mal et n'apprend rien.

   Format html : rendu avec échappement automatique, affiché en white-space
   pre-wrap — le texte garde ses retraits, les mesures sortent en tableaux.
   Les styles sont posés en ligne pour survivre au copier-coller vers Word.
#}
{%- macro titre(t) -%}
<h2 style="font-size:15px;margin:16px 0 0;white-space:normal">{{ t | upper }}</h2>
{%- endmacro -%}
{%- macro sous(t) -%}
<h3 style="font-size:13.5px;margin:10px 0 0;white-space:normal">{{ t }}</h3>
{%- endmacro -%}
{#- Mesures et DS. white-space:normal : sous pre-wrap, les retours à la ligne
    entre balises de tableau deviendraient des cellules fantômes. -#}
{%- macro tableau(lignes, masses=false) -%}
<table style="border-collapse:collapse;white-space:normal;margin:4px 0 4px 16px;font-size:13px">
<tr>{% for h in ["Mesure", "Valeur", "GC", "MA", "MB"] %}<th style="border:1px solid #999;padding:2px 8px;text-align:left;background:#f2f2f2">{{ h }}</th>{% endfor %}</tr>
{% for l in lignes %}
<tr{% if l.alerte %} style="font-weight:bold;background:#fff1e0"{% endif %}><td style="border:1px solid #999;padding:2px 8px">{{ l.label }}{% if l.alerte %} ⚠{% endif %}</td><td style="border:1px solid #999;padding:2px 8px">{% if masses %}{{ l.detail }}{% else %}{{ l.valeur | fr }} {{ l.unite }}{% endif %}</td>{% for z in [l.z_gc, l.z_ma, l.z_mb] %}<td style="border:1px solid #999;padding:2px 8px;text-align:right">{{ z | zt }}</td>{% endfor %}</tr>
{% endfor %}
</table>
{%- endmacro -%}
{%- macro champs(etape) -%}
{% for c in etape.champs %}
  {{ c.label }} : {{ c | valeur }}
{% endfor %}
{%- endmacro -%}
