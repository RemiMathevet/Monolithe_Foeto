#!/bin/sh
# Refuse un commit qui introduit un numero de dossier reel.
# Depot public : seuls les numeros fictifs du README ont le droit d'y figurer.
# ponytail: grep sur les lignes ajoutees, pas sur l'arbre entier — un fichier
# deja commite ne redeclenche pas le garde-fou a chaque commit suivant.

# Plage reservee aux cas de demonstration generes par
# hub/exemples/generer_cas.py : 25P9990 a 25P9999.
FICTIFS='26P0123|25P1234|25P999[0-9]'

# Pas de \b : « _ » compte comme lettre pour grep, et un numero colle a un
# souligne (_NNPNNNN_administratif.json, nommage des archives et exports)
# passait sans etre vu. On decoupe donc chaque ligne en mots — tout ce qui
# n'est ni lettre ni chiffre separe — et on compare des mots entiers.
# --diff-filter avec R : un fichier renomme ET modifie compte aussi.
# Le hook s'exclut lui-meme : sa liste FICTIFS ressemble a un numero.
trouves=$(git diff --cached --diff-filter=ACMR -U0 -- . ':!.githooks/pre-commit' |
          grep '^+' |
          tr -c 'A-Za-z0-9\n' '\n' |
          grep -Exi '[0-9]{2}[PAB][0-9]{3,6}' |
          grep -Evi "^($FICTIFS)$" |
          sort -u)

if [ -n "$trouves" ]; then
  echo "pre-commit : numero(s) de dossier non fictif(s) dans les lignes ajoutees :" >&2
  echo "$trouves" | sed 's/^/  /' >&2
  echo "Depot public — retirer ces numeros, ou les ajouter a FICTIFS si ils le sont." >&2
  exit 1
fi
